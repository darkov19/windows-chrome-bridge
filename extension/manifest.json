{
  "manifest_version": 3,
  "name": "Windows Chrome Bridge",
  "version": "0.6.2",
  "description": "Lets an AI agent in WSL control this Chrome profile through Windows Chrome Bridge.",
  "permissions": [
    "debugger",
    "nativeMessaging",
    "tabs",
    "downloads",
    "offscreen",
    "system.display"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Connect Windows Chrome Bridge"
  },
  "key": ""
}
